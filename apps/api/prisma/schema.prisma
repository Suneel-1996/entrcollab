generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model ApplicationUser {
  id                  String        @id @default(uuid()) @db.Uuid
  providerSubject     String        @unique @db.Uuid
  status              AccountStatus @default(ACTIVE)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  deletionRequestedAt DateTime?     @db.Timestamptz(3)
  profile             Profile?
  ideaProjects        IdeaProject[]
}

enum ProfileFieldVisibility {
  PRIVATE
  MEMBERS
}

model Profile {
  userId                 String @id @db.Uuid
  user                   ApplicationUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  displayName            String @db.VarChar(80)
  bio                    String @default("") @db.VarChar(2000)
  skills                 String[] @default([])
  interests              String[] @default([])
  availability           String @default("") @db.VarChar(200)
  displayNameVisibility  ProfileFieldVisibility @default(PRIVATE)
  bioVisibility          ProfileFieldVisibility @default(PRIVATE)
  skillsVisibility       ProfileFieldVisibility @default(PRIVATE)
  interestsVisibility    ProfileFieldVisibility @default(PRIVATE)
  availabilityVisibility ProfileFieldVisibility @default(PRIVATE)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
}

enum IdeaProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum IdeaProjectVisibility {
  PRIVATE
  MEMBERS
}

model IdeaProject {
  id           String                @id @default(uuid()) @db.Uuid
  ownerId      String                @db.Uuid
  owner        ApplicationUser       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title        String                @db.VarChar(120)
  summary      String                @default("") @db.VarChar(280)
  description  String                @default("") @db.VarChar(5000)
  neededSkills String[]              @default([])
  tags         String[]              @default([])
  status       IdeaProjectStatus     @default(DRAFT)
  visibility   IdeaProjectVisibility @default(PRIVATE)
  publishedAt  DateTime?             @db.Timestamptz(3)
  archivedAt   DateTime?             @db.Timestamptz(3)
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)

  @@index([ownerId, status, updatedAt(sort: Desc), id(sort: Desc)], map: "IdeaProject_owner_state_updated_idx")
  @@index([status, visibility, updatedAt(sort: Desc), id(sort: Desc)], map: "IdeaProject_state_visibility_updated_idx")
}
