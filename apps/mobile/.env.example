# Public configuration only. Never put service-role or Google client secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact owner-approved native callback URI; register it in Supabase and rebuild the dev app.
EXPO_PUBLIC_AUTH_REDIRECT_URI=
# Reachable HTTPS API base ending in /api/v1; loopback HTTP is allowed for local tests only.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_ENABLE_EMAIL_OTP=false
